---
import '../styles/global.css';
import PrinterHead from '../components/PrinterHead.astro';
import PaperSheet from '../components/PaperSheet.astro';

interface Props {
  title: string;
  description: string;
  job: string;
  prevHref: string;
  nextHref: string;
  greenbars?: boolean;
}
const { title, description, job, prevHref, nextHref, greenbars = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DotGothic16&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Reenie+Beanie&display=swap"
    />
  </head>
  <body>
    <PrinterHead job={job} prevHref={prevHref} nextHref={nextHref} />
    <main>
      <PaperSheet greenbars={greenbars}>
        <slot />
      </PaperSheet>
    </main>
  </body>
</html>
